# Copy to .env. Every variable is optional except DESK_TOKEN when NODE_ENV=production.
# With none set the API boots on an in-memory store with an in-process bus and scheduler.

# --- Core ---
# Single-user passphrase for POST /api/auth/login. Required in production, 12+ characters.
DESK_TOKEN=
# postgres://user:pass@host:5432/db  (unset = in-memory store, state lost on restart)
DATABASE_URL=
# redis://host:6379  (unset = in-process pub/sub and timers)
REDIS_URL=
PORT=8080
# Bind address. Default 127.0.0.1 outside production, 0.0.0.0 in production.
HOST=
# development | test | production
NODE_ENV=
LOG_LEVEL=info
# Overrides the profile's timezone for quiet hours and the 06:30 brief, e.g. America/Chicago
DESK_TZ=

# --- Push ---
# Web push keys. Leave both empty and a pair is generated on first boot and stored in kv "push.vapid".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@your-domain or an https URL. Push services may reject a placeholder; set a real one in production.
VAPID_SUBJECT=
# Telegram fallback, P0 notifications only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Inbound ---
# Shared secret the TradingView alert sends as "secret" to POST /api/hooks/tradingview. Unset = webhook off.
TV_WEBHOOK_SECRET=
# Real-time index feed from TradingView's public stream. Default NQ=IG:NASDAQ (IG US Tech 100 cash, tick by tick).
# Format DESK_SYMBOL=EXCHANGE:SYMBOL, comma-separated. Set to off to fall back to the delayed sources.
TV_STREAM_SYMBOLS=NQ=IG:NASDAQ

# --- LLM (headline classification, briefs, Ask). Unset = rules-only paths. ---
ANTHROPIC_API_KEY=

# --- Paid feeds. Each key switches its adapter on; unset = the free source. ---
POLYGON_API_KEY=
DATABENTO_API_KEY=
TRADIER_TOKEN=
ALPACA_KEY_ID=
ALPACA_SECRET=
TRADING_ECONOMICS_KEY=
FRED_API_KEY=
BENZINGA_API_KEY=
KALSHI_KEY_ID=
SPOTGAMMA_KEY=
