{
  "instrument": {
    "symbol": "NQ",
    "yahoo_symbol": "NQ=F",
    "tradovate_symbol": "NQZ6",
    "tick_size": 0.25,
    "point_value": 20.0
  },

  "mode": "propose",
  "paper": true,
  "i_accept_live_autonomous_risk": false,

  "heartbeat_seconds": 60,
  "model": "claude-opus-5-5",
  "effort": "high",

  "data": {
    "source": "yahoo",
    "interval": "5m",
    "lookback_days": 5,
    "news_symbols": ["NQ=F", "^NDX", "QQQ"]
  },

  "broker": {
    "kind": "paper",
    "paper_starting_equity": 25000,
    "paper_slippage_ticks": 1,
    "paper_commission_per_side": 2.25,
    "tradovate": {
      "env": "demo",
      "username_env": "TRADOVATE_USER",
      "password_env": "TRADOVATE_PASS",
      "cid_env": "TRADOVATE_CID",
      "sec_env": "TRADOVATE_SEC",
      "app_id": "jarvis",
      "app_version": "1.0",
      "account_id": null
    }
  },

  "risk": {
    "max_contracts": 1,
    "max_daily_loss_usd": 500,
    "max_daily_trades": 4,
    "max_consecutive_losses": 2,
    "cooldown_minutes_after_loss": 15,
    "min_stop_points": 5,
    "max_stop_points": 40,
    "min_reward_risk": 1.5,
    "max_open_positions": 1,
    "min_confidence": 0.6,
    "kill_file": "STOP"
  },

  "session": {
    "timezone": "America/New_York",
    "trade_windows": [["09:35", "11:30"], ["13:30", "15:45"]],
    "flatten_at": "15:55",
    "no_trade_dates": [],
    "event_blackouts": [
      {"label": "CPI", "date": "2026-11-12", "time": "08:30", "minutes_before": 10, "minutes_after": 15},
      {"label": "FOMC", "date": "2026-11-05", "time": "14:00", "minutes_before": 15, "minutes_after": 30}
    ]
  },

  "knowledge": {
    "dir": "knowledge",
    "top_k": 6,
    "always_include": ["playbook.md"],
    "extra_dirs": []
  },

  "notify": {
    "webhook_url_env": "JARVIS_WEBHOOK_URL"
  },

  "state_dir": "state"
}
